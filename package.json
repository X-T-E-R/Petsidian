{
  "name": "petsidian",
  "version": "0.1.0",
  "description": "A desktop-only detached pet companion plugin for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit"
