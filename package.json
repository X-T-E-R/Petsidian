{
  "name": "petsidian",
  "version": "0.1.0",
  "description": "A desktop-only detached pet companion hosted by Obsidian.",
  "main": "dist/main.js",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "generate:preload": "node esbuild.config.mjs --generate-preload-source",
    "pretypecheck": "pnpm generate:preload",
    "typecheck": "tsc --noEmit",
    "link:test-vault": "node scripts/link-test-vault.mjs",
    "enable:test-vault-plugin": "node scripts/enable-test-vault-plugin.mjs",
    "prepare:test-vault": "node scripts/prepare-test-vault.mjs",
    "smoke:obsidian": "node scripts/obsidian-smoke.mjs",
    "smoke:obsidian:attached": "node scripts/obsidian-attached-smoke.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pet",
    "companion"
  ],
  "author": "X-T-E-R",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/X-T-E-R/Petsidian.git"
  },
  "bugs": {
    "url": "https://github.com/X-T-E-R/Petsidian/issues"
  },
  "homepage": "https://github.com/X-T-E-R/Petsidian#readme",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.12.3",
    "typescript": "^5.9.3"
  }
}
