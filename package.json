  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pet",
    "companion"
  ],
  "author": "X-T-E-R",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.12.3",
    "typescript": "^5.9.3"
  }
}
